# Shared environment settings
NODE_ENV=development

# PostgreSQL connection (local or via docker-compose.db)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public&client_encoding=UTF8
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# HTTP API and security
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# JWT secrets — at least 32 characters
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# Rate-limit window in ms (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Vite: backend URLs for REST and Socket.IO
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
VITE_APP_NAME=Pulse
