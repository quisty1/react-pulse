{
  "name": "pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse — real-time team messenger for modern workspaces",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pulse/api --filter @pulse/web dev",
    "dev:api": "pnpm --filter @pulse/api dev",
    "dev:web": "pnpm --filter @pulse/web dev",
    "build": "pnpm --filter @pulse/shared build && pnpm --filter @pulse/api build && pnpm --filter @pulse/web build",
    "lint": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" lint",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" test",
    "test:e2e": "pnpm --filter @pulse/web test:e2e",
    "storybook": "pnpm --filter @pulse/web storybook",
    "db:generate": "pnpm --filter @pulse/api db:generate",
    "db:migrate": "pnpm --filter @pulse/api db:migrate",
    "db:seed": "pnpm --filter @pulse/api db:seed",
    "db:push": "pnpm --filter @pulse/api db:push",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:embedded": "pnpm --filter @pulse/api db:embedded",
    "setup": "pnpm --filter @pulse/shared build && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
